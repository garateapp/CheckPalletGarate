{
  "expo": {
    "name": "CheckPalletGarate",
    "slug": "checkpalletgarate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F2A43"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.garate.checkpalletgarate",
      "infoPlist": {
        "NSCameraUsageDescription": "CheckPalletGarate necesita la cámara para leer el código de barra del folio del pallet."
      }
    },
    "android": {
      "package": "com.garate.checkpalletgarate",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A43"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a CheckPalletGarate usar la cámara para escanear códigos de barra de pallets."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://produccion.garatehermanos.cl/api/v1",
      "eas": {
        "projectId": "1eb63e47-d8b2-441e-b5d0-dd83840c6345"
      }
    },
    "owner": "calgreenex"
  }
}
